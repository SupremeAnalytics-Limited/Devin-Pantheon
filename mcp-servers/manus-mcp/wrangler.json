{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manus-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "ManusMCP"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ManusMCP"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "MANUS_API_BASE_URL": "https://api.manus.ai"
  }
}
